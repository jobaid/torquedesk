# Rename to .env in the same directory as docker-compose.yml.
# NEVER commit the real .env — add it to .gitignore if it isn't already.

# Postgres password for the containerised DB. Anything long + random.
DB_PASSWORD=change-me-to-a-long-random-string

# AES-GCM encryption key — 32 bytes, base64-encoded. MUST exactly match
# the TORQUEDESK_SECRET_KEY the pre-Docker server was using. If you
# generate a new one, every previously-encrypted row (SMTP passwords,
# OAuth refresh tokens, Stripe secrets) becomes unreadable.
# Generate a fresh one with: openssl rand -base64 32
TORQUEDESK_SECRET_KEY=paste-your-existing-key-here

# Optional — enables Sign in with Google / Microsoft for shop email.
# Leave blank to keep only the app-password flow available.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=https://apps.2set.com

# Base URL used in password-reset emails. Auto-detected from the
# incoming request if left blank, but setting it explicitly is more
# reliable behind proxies.
RESET_BASE_URL=https://apps.2set.com
